# --- Android API Base URLs ---
API_BASE_URL=http://10.0.2.2:4000/
PRODUCTION_API_BASE_URL=https://ais-dev-jikcox2ra6y7i7pgcwl5hu-593908721251.asia-southeast1.run.app/

