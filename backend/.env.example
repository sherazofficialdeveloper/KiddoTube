# KidsStream Backend Environment Configuration Template
# ========================================================

# Server Port
PORT=4000
BACKEND_PORT=4000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Required for encrypted parent-only viewing of child passwords.
# Generate a unique 32-byte base64 key and keep it outside the database.
CHILD_PASSWORD_ENCRYPTION_KEY=

# MongoDB Database Configuration
# Local WiredTiger MongoDB instance or MongoDB Atlas URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=kidsstream

# YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here
# Optional signed-in YouTube cookie for server-side downloads when YouTube
# returns BOT_CHECK from the hosting provider IP. Never commit a real cookie.
YT_COOKIE=
# Alternative: mount a Netscape cookies.txt file on the server and provide
# its path instead of putting the cookie contents in an environment variable.
YT_COOKIE_FILE=

# Resend Email Service Configuration (for Password Reset OTP)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=KiddoTube <onboarding@resend.dev>
